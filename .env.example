# Copy this file to .env.local (for running on your PC) and fill in the values.
# On Vercel, add the same three names under Project > Settings > Environment Variables.
# Supabase Dashboard > Project Settings > API:
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-public-key
# KEEP SECRET: never put this in the browser, GitHub or chat.
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key
# Where invite / password links send people back to (no trailing slash).
# Local: http://localhost:3000   Production: https://your-domain.com
SITE_URL=http://localhost:3000

# ---- Stripe (card payments in the customer portal) ----
# Stripe Dashboard > Developers > API keys. Use the TEST key (sk_test_...) until launch.
# KEEP SECRET, like the Supabase service_role key.
STRIPE_SECRET_KEY=sk_test_paste-your-secret-key
# Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_paste-your-signing-secret

# ---- Email (SMTP) ----
# cPanel > Email Accounts > (the mailbox) > Connect Devices shows these. Use a dedicated mailbox,
# e.g. portal@yourdomain.com. Every email (invites, updates, password resets) goes through these.
SMTP_HOST=mail.yourdomain.com
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=portal@yourdomain.com
# KEEP SECRET, like the Supabase service_role key.
SMTP_PASS=the-mailbox-password
EMAIL_FROM=Parceros Collision Center <portal@yourdomain.com>
# Where customers' replies go (the shop's inbox).
EMAIL_REPLY_TO=office@yourdomain.com
# Where "new estimate request" alerts go (defaults to EMAIL_REPLY_TO).
SHOP_NOTIFY_EMAIL=office@yourdomain.com
# TESTING ONLY: every email goes to this address instead of the customer. Delete it at handover.
EMAIL_TEST_TO=you@example.com
